<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="using:Avalonia.Data.Converters" xmlns:m="using:Merostrap.Macros" xmlns:local="using:Merostrap.UI.Elements.Macros" xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
 x:Class="Merostrap.UI.Elements.Macros.MacroWindow" x:DataType="m:MacroWorkspace"
 Title="Merostrap Macro" Width="760" Height="540" MinWidth="680" MinHeight="440"
 WindowStartupLocation="CenterScreen" WindowDecorations="None" CanResize="False"
 ShowInTaskbar="True" ShowActivated="True" Topmost="False" TransparencyLevelHint="Transparent"
 TransparencyBackgroundFallback="Transparent" Background="Transparent" Foreground="{DynamicResource MacroText}" RequestedThemeVariant="Dark">
 <Window.Styles>
  <Style Selector="NumericUpDown"><Setter Property="Background" Value="{DynamicResource MacroTextField}"/><Setter Property="Foreground" Value="{DynamicResource MacroText}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,5"/></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner">
   <Setter Property="Template"><ControlTemplate><Grid><ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Spacing="2" IsVisible="{TemplateBinding ShowButtonSpinner}"><RepeatButton x:Name="PART_DecreaseButton" Width="22" Height="24" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Decrease value"><ic:Lucide Icon="Minus" Width="12" Height="12" StrokeBrush="{DynamicResource MacroMuted}"/></RepeatButton><RepeatButton x:Name="PART_IncreaseButton" Width="22" Height="24" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="Increase value"><ic:Lucide Icon="Plus" Width="12" Height="12" StrokeBrush="{DynamicResource MacroMuted}"/></RepeatButton></StackPanel></Grid></ControlTemplate></Setter>
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
   <Setter Property="Template"><ControlTemplate><Border x:Name="MacNumberButton" Background="{DynamicResource MacroInput}" CornerRadius="4"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ Border#MacNumberButton"><Setter Property="Background" Value="{DynamicResource MacroSelection}"/></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pressed /template/ Border#MacNumberButton"><Setter Property="Background" Value="{DynamicResource MacroInterior}"/></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:disabled"><Setter Property="Opacity" Value="0.4"/></Style>

  <Style Selector="Button">
   <Setter Property="Background" Value="{DynamicResource MacroInput}"/><Setter Property="Foreground" Value="{DynamicResource MacroText}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="12,5"/>
   <Setter Property="Template"><ControlTemplate><Border x:Name="MacButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ Border#MacButtonSurface"><Setter Property="Background" Value="{DynamicResource MacroSelection}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="Button:pressed /template/ Border#MacButtonSurface"><Setter Property="Background" Value="{DynamicResource MacroInterior}"/></Style>
  <Style Selector="Button:focus-visible /template/ Border#MacButtonSurface"><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
  <Style Selector="ToggleSwitch">
   <Setter Property="MinWidth" Value="0"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><ControlTemplate><Grid Background="Transparent" Height="30" Width="40"><Border x:Name="MacSwitchTrack" Height="22" CornerRadius="11" Background="{DynamicResource MacroBorder}"/><Canvas x:Name="PART_SwitchKnob" Width="20" Height="20" HorizontalAlignment="Left" IsVisible="False"><Grid x:Name="PART_MovingKnobs" Width="20" Height="20"/></Canvas><Border x:Name="MacSwitchThumb" RenderTransform="translate(0px, 0px)" Width="18" Height="18" CornerRadius="9" Background="#F5F5F7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"><Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/></Transitions></Border.Transitions></Border></Grid></ControlTemplate></Setter>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#MacSwitchThumb"><Setter Property="RenderTransform" Value="translate(16px, 0px)"/></Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#MacSwitchTrack"><Setter Property="Background" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#MacSwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource MacroText}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="ToggleSwitch:pointerover /template/ Border#MacSwitchThumb"><Setter Property="Background" Value="White"/></Style>
  <Style Selector="ToggleSwitch:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
  <Style Selector="TextBox"><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource MacroText}"/><Setter Property="CaretBrush" Value="{DynamicResource MacroAccent}"/><Setter Property="SelectionBrush" Value="{DynamicResource MacroSelection}"/></Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource MacroTextField}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource MacroMuted}"/></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource MacroTextField}"/></Style>

  <Style Selector="Border.settings-card"><Setter Property="Background" Value="{DynamicResource MacroSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="48"/></Style>
  <Style Selector="Button.chrome-dot"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style Selector="Button.chrome-dot:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TextBlock.chrome-glyph"><Setter Property="Opacity" Value="0"/></Style>
  <Style Selector="Button.chrome-dot:pointerover TextBlock.chrome-glyph"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource MacroInput}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource MacroInput}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style Selector="ToggleButton.disclosure">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover"><Setter Property="Background" Value="{DynamicResource MacroInput}"/></Style>
  <Style Selector="ListBoxItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="34"/><Setter Property="CornerRadius" Value="5"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource MacroSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource MacroSelection}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>

  <Style Selector="ToggleButton#SearchToggle"><Setter Property="Template"><ControlTemplate><Border Background="Transparent"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter></Style>
  <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="TextBox#SearchBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><ControlTemplate><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><Panel><TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource MacroMuted}" VerticalAlignment="Center" IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}"/><TextPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}" CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}" CaretBrush="{TemplateBinding CaretBrush}" TextWrapping="NoWrap" VerticalAlignment="Center"/></Panel></ScrollViewer></Border></ControlTemplate></Setter>
  </Style>

  <Style Selector="ComboBox">
   <Setter Property="Background" Value="{DynamicResource MacroTextField}"/><Setter Property="Foreground" Value="{DynamicResource MacroText}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/>
   <Setter Property="Template"><ControlTemplate><Grid>
    <Border x:Name="MacDropdownSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Grid ColumnDefinitions="*,24"><Panel><TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource MacroMuted}" VerticalAlignment="Center" IsVisible="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNull}}"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/></Panel><ic:Lucide x:Name="MacDropdownArrow" Grid.Column="1" Icon="ChevronDown" Width="13" Height="13" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border>
    <Popup Closed="DropdownClosed" Opened="DropdownOpened" x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="MacDropdownSurface" Placement="Bottom" VerticalOffset="4" IsLightDismissEnabled="True" MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" WindowManagerAddShadowHint="False"><Border x:Name="MacDropdownMenu" Background="{DynamicResource MacroTextField}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" Padding="4"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#MacDropdownSurface"><Setter Property="BorderBrush" Value="{DynamicResource MacroMuted}"/></Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#MacDropdownSurface"><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="ComboBox#PresetSelector /template/ ContentPresenter"><Setter Property="Margin" Value="0,0,28,0"/></Style>
  <Style Selector="ComboBox:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
  <Style Selector="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource MacroText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><ControlTemplate><Border x:Name="MacDropdownItem" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Grid ColumnDefinitions="*,22"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/><ic:Lucide x:Name="SelectedMark" Grid.Column="1" Icon="Check" Width="13" Height="13" StrokeBrush="{DynamicResource MacroAccent}" IsVisible="False" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ Border#MacDropdownItem"><Setter Property="Background" Value="{DynamicResource MacroSurface}"/></Style>
  <Style Selector="ComboBoxItem:selected /template/ Border#MacDropdownItem"><Setter Property="Background" Value="{DynamicResource MacroSelection}"/></Style>
  <Style Selector="ComboBoxItem:selected /template/ ic|Lucide#SelectedMark"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="Border#ContentFrame"><Setter Property="Padding" Value="14,12"/></Style>
  <Style Selector="Border#ContentFrame.macro-page"><Setter Property="Padding" Value="14,0"/></Style>

  <Style Selector="ScrollViewer#MacroListScroll /template/ ScrollBar:vertical, ListBox#CategoryList /template/ ScrollViewer /template/ ScrollBar:vertical">
   <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><ControlTemplate><Grid Background="Transparent" Margin="0,6"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="Vertical" IsDirectionReversed="True">
    <Track.DecreaseButton><RepeatButton Focusable="False" Background="Transparent"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseButton>
    <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate><Border x:Name="CleanScrollThumb" Width="4" HorizontalAlignment="Center" Background="{DynamicResource MacroSubtle}" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseButton><RepeatButton Focusable="False" Background="Transparent"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseButton>
   </Track></Grid></ControlTemplate></Setter>
  </Style>

  <Style Selector="CheckBox.macro-enable">
   <Setter Property="Width" Value="22"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><ControlTemplate><Border x:Name="MacroTickTarget" Width="18" Height="18" CornerRadius="3" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" Background="Transparent"><ic:Lucide x:Name="MacroCheckMark" Icon="Check" Width="14" Height="14" StrokeBrush="{DynamicResource MacroAccent}" Opacity="0"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="CheckBox.macro-enable:checked /template/ Border#MacroTickTarget"><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="CheckBox.macro-enable:pointerover /template/ Border#MacroTickTarget"><Setter Property="BorderBrush" Value="{DynamicResource MacroMuted}"/></Style>
  <Style Selector="CheckBox.macro-enable:focus-visible /template/ Border#MacroTickTarget"><Setter Property="BorderBrush" Value="{DynamicResource MacroAccent}"/></Style>
  <Style Selector="CheckBox.macro-enable:checked /template/ ic|Lucide#MacroCheckMark"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="CheckBox.macro-enable:not(:checked):pointerover /template/ ic|Lucide#MacroCheckMark"><Setter Property="Opacity" Value="0.35"/></Style>
  <Style Selector="CheckBox.macro-enable:not(:checked):focus-visible /template/ ic|Lucide#MacroCheckMark"><Setter Property="Opacity" Value="0.35"/></Style>
  <Style Selector="CheckBox.macro-enable:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
  <Style Selector="Border.macro-row"><Setter Property="Background" Value="{DynamicResource MacroSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource MacroBorder}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.macro-row.enabled"><Setter Property="BorderBrush" Value="#83DCAF"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Styles>
 <Border x:Name="GuiSurface" Margin="2" Padding="1" Background="{DynamicResource MacroBackground}" BorderBrush="{DynamicResource MacroFrame}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" RenderTransformOrigin="50%,50%">
 <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
 <Grid RowDefinitions="48,*">
  <Grid Grid.Row="0" ColumnDefinitions="86,*,86" Margin="14,0">
   <Border Grid.ColumnSpan="3" PointerPressed="TitlePressed" Background="Transparent"/>
   <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button x:Name="CloseButton" Classes="chrome-dot" Click="CloseClicked" AutomationProperties.Name="Exit macro" ToolTip.Tip="Exit"><Grid><Ellipse Width="13" Height="13" Fill="#FF5F57"/><TextBlock Classes="chrome-glyph" Text="×" FontSize="13" Foreground="#522624" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
    <Button x:Name="MinimizeButton" Classes="chrome-dot" Click="MinimizeClicked" AutomationProperties.Name="Minimize macro" ToolTip.Tip="Minimize"><Grid><Ellipse Width="13" Height="13" Fill="#FEBC2E"/><TextBlock Classes="chrome-glyph" Text="−" FontSize="13" Foreground="#5B4318" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
    <Button x:Name="ExpandButton" Classes="chrome-dot" Click="ExpandClicked" AutomationProperties.Name="Expand or restore macro GUI" ToolTip.Tip="Expand or restore"><Grid><Ellipse Width="13" Height="13" Fill="#28C840"/><TextBlock Classes="chrome-glyph" Text="+" FontSize="12" Foreground="#185723" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
   </StackPanel>
   <Border x:Name="SearchSurface" Grid.Column="1" Grid.ColumnSpan="2" Width="30" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" ClipToBounds="True" Background="Transparent" BorderThickness="0">
    <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
    <Grid Width="250" ColumnDefinitions="220,30" HorizontalAlignment="Right">
     <TextBox x:Name="SearchBox" Text="{Binding Search, Mode=TwoWay}" IsVisible="False" Width="0" Height="30" MinHeight="0" MinWidth="0" Padding="10,0" VerticalContentAlignment="Center" PlaceholderText="Search macros" FontSize="12" KeyDown="SearchKeyDown" AutomationProperties.Name="Search macros"/>
     <ToggleButton x:Name="SearchToggle" Grid.Column="1" Click="SearchToggleClicked" Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Expand or collapse macro search" ToolTip.Tip="Search macros"><ic:Lucide Icon="Search" Width="15" Height="15" StrokeBrush="{DynamicResource MacroMuted}"/></ToggleButton>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="142,12,*" Margin="12,0,12,12">
   <Border x:Name="SidebarFrame" Background="{DynamicResource MacroHeader}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" CornerRadius="6"/>
    <ListBox x:Name="CategoryList" Margin="6" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Background="Transparent" BorderThickness="0" FontSize="12" AutomationProperties.Name="Macro categories">
     <ListBox.Template><ControlTemplate><ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"><ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></ScrollViewer></ControlTemplate></ListBox.Template>
     <ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" VerticalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   <Border x:Name="ContentFrame" Classes.macro-page="{Binding IsMacroPage}" Grid.Column="2" Background="{DynamicResource MacroInterior}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" CornerRadius="8">
   <Grid>
    <Grid>
     <ScrollViewer IsVisible="{Binding IsSettingsPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Border IsVisible="{Binding IsSettingsPage}" Background="{DynamicResource MacroSurface}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" CornerRadius="0" ClipToBounds="True" Margin="2,0" VerticalAlignment="Top">
     <StackPanel x:Name="SettingsPanel" IsVisible="{Binding IsSettingsPage}" Spacing="0">
      <Border Classes="settings-card"><Grid ColumnDefinitions="*,Auto" MinHeight="34">
       <TextBlock Text="Reduce motion" FontSize="13" VerticalAlignment="Center"/>
       <CheckBox Classes="macro-enable" Grid.Column="1" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" AutomationProperties.Name="Reduce motion"/>
      </Grid></Border>


      <Border Classes="settings-card"><Grid ColumnDefinitions="28,*,240" MinHeight="34">
       <ic:Lucide Icon="Monitor" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="Display" VerticalAlignment="Center" FontSize="13"/>
       <ComboBox x:Name="DisplayPicker" Grid.Column="2" ItemsSource="{Binding DisplayOptions}" SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}" Height="34" HorizontalAlignment="Stretch" AutomationProperties.Name="Display for Autopender and overlays"/>
      </Grid></Border>
      <Border Classes="settings-card">
       <Grid ColumnDefinitions="28,*,Auto" Height="34">
        <ic:Lucide Icon="Keyboard" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="GUI keybind" VerticalAlignment="Center" FontSize="13"/>
        <local:KeybindButton x:Name="GuiKeybindPicker" Grid.Column="2" HorizontalAlignment="Right" Value="{Binding GuiKeybind, Mode=TwoWay}" AutomationProperties.Name="Show or hide macro GUI hotkey"/>
       </Grid>
      </Border>
      <Border Classes="settings-card">
       <Grid ColumnDefinitions="28,*,190" Height="34">
        <ic:Lucide Icon="Palette" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Theme" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="ThemePicker" Grid.Column="2" ItemsSource="{Binding GuiThemes}" SelectedItem="{Binding GuiTheme, Mode=TwoWay}" Height="34" HorizontalAlignment="Stretch" AutomationProperties.Name="Macro GUI theme"/>
       </Grid>
      </Border>

      <Border Classes="settings-card">
       <StackPanel Spacing="12">
        <Grid ColumnDefinitions="28,*,190" Height="34">
         <ic:Lucide Icon="Layers" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="Preset" VerticalAlignment="Center" FontSize="13"/>
         <Border Grid.Column="2" Background="{DynamicResource MacroTextField}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1">
          <Grid ColumnDefinitions="*,28,28">
         <ComboBox x:Name="PresetSelector" Grid.ColumnSpan="3" Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedIndex="{Binding SelectedProfileIndex, Mode=TwoWay}" Height="32" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" FontSize="12" AutomationProperties.Name="Active preset"/>
         <TextBox x:Name="PresetNameBox" Grid.Column="0" IsVisible="{Binding IsChecked, ElementName=RenameToggle}" Text="{Binding PresetName, Mode=TwoWay}" Height="32" MinHeight="0" Background="{DynamicResource MacroTextField}" BorderThickness="0" CornerRadius="0" Padding="10,5" FontSize="12" MaxLength="48" AutomationProperties.Name="Preset name">
          <TextBox.Template><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><TextPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}" CaretIndex="{TemplateBinding CaretIndex}" SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}" SelectionBrush="{DynamicResource MacroAccent}" CaretBrush="{DynamicResource MacroText}" VerticalAlignment="Center"/></ScrollViewer></Border></ControlTemplate></TextBox.Template>
         </TextBox>
         <ToggleButton Classes="disclosure" x:Name="RenameToggle" Click="RenamePresetClicked" Grid.Column="1" Width="24" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Rename preset" AutomationProperties.Name="Rename preset"><ic:Lucide Icon="Pencil" Width="14" Height="14" StrokeBrush="{DynamicResource MacroMuted}"/></ToggleButton>
          </Grid>
         </Border>
        </Grid>
       </StackPanel>
      </Border>
      <Border Classes="settings-card">
       <Grid ColumnDefinitions="28,*,190" Height="34">
        <ic:Lucide Icon="PanelsTopLeft" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Floating overlay" VerticalAlignment="Center" FontSize="13"/>
        <ToggleSwitch x:Name="OverlayVisibilityToggle" Grid.Column="2" IsChecked="{Binding OverlayVisible, Mode=TwoWay}" Width="40" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" AutomationProperties.Name="Show Deepwoken macro overlay"/>
       </Grid>
      </Border>
      <Border Classes="settings-card">
       <Grid ColumnDefinitions="28,*,190" Height="34">
        <ic:Lucide Icon="RotateCcw" Width="18" Height="18" StrokeBrush="{DynamicResource MacroMuted}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="Overlay position" VerticalAlignment="Center" FontSize="13"/>
        <Button x:Name="ResetOverlayPositionButton" Grid.Column="2" Content="Reset position" Command="{Binding ResetPositionCommand}" Height="34" HorizontalAlignment="Stretch"/>
       </Grid>
      </Border>


     </StackPanel>
     </Border>
     </ScrollViewer>
     <ScrollViewer x:Name="MacroListScroll" Margin="0,0,-12,0" IsVisible="{Binding IsMacroPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border x:Name="MacroListFrame" Background="{DynamicResource MacroSurface}" BorderBrush="{DynamicResource MacroBorder}" BorderThickness="1" CornerRadius="0" ClipToBounds="True" Margin="2,12,14,12" Padding="0">
      <StackPanel>
      <Border IsVisible="{Binding IsSilentheartPage}"><local:FlowStateOverlayPanel DataContext="{Binding FlowStateOverlay}"/></Border>
      <ItemsControl x:Name="MacroListItems" ItemsSource="{Binding VisibleMacros}">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="m:MacroRow">
         <Border Classes="macro-row" Classes.enabled="{Binding Enabled}">
          <Grid RowDefinitions="48,Auto" ColumnDefinitions="*,Auto" Margin="12,0">
           <ToggleButton Grid.Column="0" Classes="disclosure" HorizontalAlignment="Stretch" IsEnabled="{Binding Supported}" IsChecked="{Binding Enabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Description}">
            <Grid ColumnDefinitions="*,Auto">
             <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
             <TextBlock Grid.Column="1" Text="Unavailable" IsVisible="{Binding Unavailable}" FontSize="11" Foreground="#A49884" VerticalAlignment="Center" ToolTip.Tip="{Binding SupportNote}" Margin="8,0"/>
            </Grid>
           </ToggleButton>
           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0" VerticalAlignment="Center">
            <local:KeybindButton IsVisible="{Binding HasHeaderKey}" Value="{Binding HeaderKeyValue, Mode=TwoWay}" IsEnabled="{Binding Supported}" AutomationProperties.Name="{Binding Name}"/>
           </StackPanel>
           <StackPanel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding ShowDetails}" Margin="0,0,0,14">
            <StackPanel IsVisible="{Binding IsRitual}" Spacing="8" Margin="0,4,0,12">
             <TextBlock Text="{Binding RitualAreaLabel}" Foreground="{DynamicResource MacroMuted}" FontSize="12"/>
             <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Auto-detect" Click="DetectRitualClicked" AutomationProperties.Name="Auto-detect ritual prompt"/>
              <Button Content="Select area" Click="SelectRitualClicked" AutomationProperties.Name="Select ritual prompt area"/>
             </StackPanel>
            </StackPanel>
           <ItemsControl ItemsSource="{Binding DetailFields}">
            <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="m:MacroFieldRow">
              <Grid IsVisible="{Binding IsShown}" ColumnDefinitions="160,*" Margin="0,4" MinHeight="32">
               <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource MacroMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" ToolTip.Tip="{Binding Help}"/>
               <TextBox Grid.Column="1" IsVisible="{Binding IsText}" PasswordChar="{Binding SecretMask}" Text="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Help}"/>
               <Button Grid.Column="1" IsVisible="{Binding IsPoint}" Content="{Binding PickLabel}" Click="PickPointClicked" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Label}"/>
               <Button Grid.Column="1" IsVisible="{Binding IsPath}" Content="{Binding PickLabel}" Click="PickPathClicked" HorizontalAlignment="Left" MaxWidth="280" ToolTip.Tip="{Binding Value}" AutomationProperties.Name="{Binding Label}"/>
               <ComboBox Grid.Column="1" IsVisible="{Binding IsChoice}" PointerPressed="FieldChoicePressed" ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="150" AutomationProperties.Name="{Binding Label}"/>
               <local:KeybindButton Grid.Column="1" IsVisible="{Binding IsKeybind}" Value="{Binding Value, Mode=TwoWay}" AllowMainMouseButtons="{Binding AllowsMainMouse}" AutomationProperties.Name="{Binding Label}"/>
               <CheckBox Classes="macro-enable" Grid.Column="1" IsVisible="{Binding IsBoolean}" IsChecked="{Binding BooleanValue, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Help}"/>
              </Grid>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
      </Border>
     </ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsHealthPage}"><local:HealthPanel DataContext="{Binding Health}"/></ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsParryPage}"><local:ParryBarPanel DataContext="{Binding ParryBar}"/></ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsDodgePage}"><local:DodgeBarPanel DataContext="{Binding DodgeBar}"/></ScrollViewer>
     <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="No macros found" FontSize="17" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
   </Grid>
   </Border>
  </Grid>

 </Grid>
 </Border>
</Window>
